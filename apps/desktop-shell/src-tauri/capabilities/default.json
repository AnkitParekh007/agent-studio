{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop shell capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:4000/*" },
        { "url": "http://127.0.0.1:4000/*" },
        { "url": "https://releases.example.com/*" }
      ]
    }
  ]
}
