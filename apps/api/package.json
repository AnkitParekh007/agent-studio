{
  "name": "@agent-studio/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-studio/application-templates": "workspace:*",
    "@agent-studio/auth": "workspace:*",
    "@agent-studio/authorization": "workspace:*",
    "@agent-studio/config": "workspace:*",
    "@agent-studio/database": "workspace:*",
    "@agent-studio/domain": "workspace:*",
    "@agent-studio/runtime-claude": "workspace:*",
    "@agent-studio/runtime-core": "workspace:*",
    "@agent-studio/runtime-local": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "bullmq": "^5.41.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
