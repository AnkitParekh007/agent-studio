# Copy to .env.production and fill in every CHANGE_ME value.
#   cp .env.production.example .env.production
# Never commit .env.production.

# --- Host ports (published by docker-compose.prod.yml) ---
# Remap if 3000–3002 collide with local `pnpm dev`.
API_HOST_PORT=4000
CONTROL_PLANE_HOST_PORT=3000
AGENT_RUNTIME_HOST_PORT=3001
EMBED_RUNTIME_HOST_PORT=3002

# --- Public URLs (browser-facing; bake into Next at build time) ---
API_BASE_URL=http://localhost:4000
BETTER_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
CONTROL_PLANE_ORIGIN=http://localhost:3000
AGENT_RUNTIME_ORIGIN=http://localhost:3001
EMBED_RUNTIME_ORIGIN=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Postgres (internal to compose network) ---
POSTGRES_USER=agentstudio
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=agentstudio

# --- Required secrets (min 32 characters each) ---
# Only the api/worker/migrate services receive these; the Next.js services do not.
BETTER_AUTH_SECRET=CHANGE_ME_better_auth_secret_at_least_32_chars
SECRETS_MASTER_KEY=CHANGE_ME_secrets_master_key_at_least_32_chars
# Required in production: guards /metrics and /api/metrics.
METRICS_BEARER_TOKEN=CHANGE_ME_metrics_bearer_token

# --- Runtime (local adapter is blocked when NODE_ENV=production) ---
DEFAULT_RUNTIME_PROVIDER=claude
ANTHROPIC_API_KEY=CHANGE_ME_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Gateway / governance ---
ALLOW_SELF_APPROVAL=false
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_MAX_CONCURRENT_SESSIONS=20
GATEWAY_SESSION_TIMEOUT_MS=900000

# --- Data retention (days) when an org has no override ---
DATA_RETENTION_DAYS=90

# --- Optional OpenTelemetry ---
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=agent-studio-api
