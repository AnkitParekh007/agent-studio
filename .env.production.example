# Copy to .env.production and fill in every CHANGE_ME value.
#   cp .env.production.example .env.production
# Never commit .env.production.

# --- Host ports (published by docker-compose.prod.yml) ---
# Remap if 3000–3002 collide with local `pnpm dev`.
API_HOST_PORT=4000
CONTROL_PLANE_HOST_PORT=3000
AGENT_RUNTIME_HOST_PORT=3001
EMBED_RUNTIME_HOST_PORT=3002
# TLS front door (Caddy). See deploy/caddy/README.md.
HTTPS_HOST_PORT=443
# HTTP_HOST_PORT=80   # required when using pnpm deploy:up:acme
# CADDY_TLS_MODE=internal | acme | file   # documentation only; compose selects via override
# ACME_EMAIL=you@example.com              # required for deploy:up:acme

# --- TLS hostnames served by Caddy on 443 ---
CADDY_API_HOST=api.localhost
CADDY_CONTROL_PLANE_HOST=studio.localhost
CADDY_AGENT_RUNTIME_HOST=apps.localhost
CADDY_EMBED_HOST=embed.localhost

# --- Public URLs (browser-facing; bake into Next at build time) ---
API_BASE_URL=http://localhost:4000
BETTER_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
CONTROL_PLANE_ORIGIN=http://localhost:3000
AGENT_RUNTIME_ORIGIN=http://localhost:3001
EMBED_RUNTIME_ORIGIN=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Postgres (internal to compose network) ---
POSTGRES_USER=agentstudio
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=agentstudio

# --- Required secrets (min 32 characters each) ---
# Only the api/worker/migrate services receive these; the Next.js services do not.
BETTER_AUTH_SECRET=CHANGE_ME_better_auth_secret_at_least_32_chars
SECRETS_MASTER_KEY=CHANGE_ME_secrets_master_key_at_least_32_chars
# Required in production: guards /metrics and /api/metrics.
METRICS_BEARER_TOKEN=CHANGE_ME_metrics_bearer_token

# --- Runtime (local adapter is blocked when NODE_ENV=production) ---
DEFAULT_RUNTIME_PROVIDER=claude
ANTHROPIC_API_KEY=CHANGE_ME_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Identity ---
# Reverse-proxy hops in front of the API (Caddy = 1). Drives client IP resolution
# for /api/auth/* rate limiting and lockout, so an over-large value lets a client
# spoof X-Forwarded-For and bypass both.
TRUST_PROXY_HOPS=1

# Enterprise SSO (Better Auth genericOAuth). Set all three to enable.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_ID=oidc
OIDC_SCOPES=openid,profile,email

# /api/auth/* abuse controls (shared across API replicas via Redis)
AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_LOCKOUT_MAX_FAILURES=10
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_DURATION_MS=900000

# Require TOTP enrollment for org_owner / org_admin / agent_approver / platform_admin.
# Enable only after those users have enrolled, or they will be locked out of the API.
REQUIRE_MFA_FOR_PRIVILEGED=false

# --- Gateway / governance ---
ALLOW_SELF_APPROVAL=false
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_MAX_CONCURRENT_SESSIONS=20
GATEWAY_SESSION_TIMEOUT_MS=900000

# --- Data retention (days) when an org has no override ---
DATA_RETENTION_DAYS=90

# --- Optional OpenTelemetry ---
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=agent-studio-api
