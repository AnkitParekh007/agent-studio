{
  "name": "agent-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.7.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @agent-studio/database generate",
    "db:migrate": "pnpm --filter @agent-studio/database migrate",
    "db:seed": "pnpm --filter @agent-studio/database seed",
    "db:studio": "pnpm --filter @agent-studio/database studio",
    "smoke": "node scripts/smoke-vertical-slice.mjs",
    "smoke:playground": "node scripts/smoke-playground.mjs",
    "smoke:application-studio": "node scripts/smoke-application-studio.mjs",
    "smoke:desktop": "node scripts/smoke-desktop-shell.mjs",
    "smoke:governance": "node scripts/smoke-phase7-governance.mjs",
    "smoke:enterprise": "node scripts/smoke-enterprise-hardening.mjs",
    "smoke:integrations": "node scripts/smoke-integrations.mjs",
    "smoke:publish-channels": "node scripts/smoke-publish-channels.mjs",
    "desktop:dev": "pnpm --filter @agent-studio/desktop-shell tauri:dev",
    "desktop:build": "pnpm --filter @agent-studio/desktop-shell tauri:build",
    "desktop:gen-updater-keys": "node scripts/generate-desktop-updater-keys.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.2"
    }
  }
}
