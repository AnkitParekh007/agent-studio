NODE_ENV=development

# Database
DATABASE_URL=postgresql://agentstudio:agentstudio@localhost:55446/agentstudio

# Redis
REDIS_URL=redis://localhost:6380

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
CONTROL_PLANE_ORIGIN=http://localhost:3000
AGENT_RUNTIME_ORIGIN=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:1420,tauri://localhost,https://tauri.localhost

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:4000

# Secrets at rest (32+ char key material; derive AES-256 key)
SECRETS_MASTER_KEY=replace-with-another-long-random-secret-key-32+

# Runtime
# local adapter is development-only; blocked when NODE_ENV=production
RUNTIME_ALLOW_LOCAL=true
DEFAULT_RUNTIME_PROVIDER=local

# Claude Managed Agents (optional for local demo)
# Docs consulted: 2026-07-26 — beta header managed-agents-2026-04-01
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Governance / gateway hardening
ALLOW_SELF_APPROVAL=false
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_MAX_CONCURRENT_SESSIONS=20
GATEWAY_SESSION_TIMEOUT_MS=900000

# Metrics scrape auth. Required when NODE_ENV=production; when set, /metrics and
# /api/metrics require `Authorization: Bearer <token>`.
METRICS_BEARER_TOKEN=
# Default runtime-telemetry retention window when an org has no override.
DATA_RETENTION_DAYS=90

# OpenTelemetry (optional). When set, API exports traces via OTLP HTTP.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=agent-studio-api
# OTEL_DEBUG=true

# Web apps
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
EMBED_RUNTIME_ORIGIN=http://localhost:3002
# Include embed origin in CORS for iframe clients
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
